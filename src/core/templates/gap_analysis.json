{
  "action": "gap_analysis",
  "zh_triggers": ["盲区", "覆盖盲区", "空白区域", "未覆盖", "服务盲区", "盲区分析"],
  "ja_triggers": ["サービス盲域", "カバーされていないエリア", "空白地域", "未カバー", "サービスギャップ"],
  "en_triggers": ["gap", "gap analysis", "uncovered", "coverage gap", "service gap"],
  "output_base": "user_data/exports/shapefiles/",
  "output_check": {"empty": "ok"},
  "params": [
    {
      "name": "source_layer",
      "type": "layer",
      "role": "source",
      "required": true,
      "comment": "源点图层（如避难所），自动从已加载图层匹配"
    },
    {
      "name": "boundary_layer",
      "type": "layer",
      "role": "boundary",
      "required": true,
      "comment": "边界面图层（如行政区划），自动从已加载图层匹配"
    },
    {
      "name": "radius_m",
      "type": "float",
      "default": 500.0,
      "comment": "缓冲区半径（米）"
    }
  ],
  "guards_on_fail": "error",
  "guards": [
    {"condition": "crs_projected", "on_fail": "error"},
    {"condition": "source_is_vector", "on_fail": "error"},
    {"condition": "source_is_point", "params": {"geometry_type": 0}, "on_fail": "error"},
    {"condition": "boundary_is_polygon", "params": {"geometry_type": 2}, "on_fail": "error"},
    {"condition": "boundary_fc_limit", "params": {"max": 10000}, "on_fail": "warn"},
    {"condition": "shapely_available", "on_fail": "error"},
    {"condition": "crs_match", "params": {"auto_reproject": true}, "on_fail": "error"}
  ],
  "steps": [
    {
      "id": "boundary_dissolve",
      "input_source": "$boundary_layer",
      "params": {
        "FIELD": [],
        "OUTPUT": "memory:"
      },
      "engine": {
        "primary": {"name": "qgis_processing", "algorithm": "native:dissolve"}
      },
      "log": "[GAP] 溶解边界图层: {fc} 要素",
      "comment": "将边界多面合并为单一多边形"
    },
    {
      "id": "boundary_buffer",
      "input_source": "$boundary_dissolve.output",
      "params": {
        "DISTANCE": "$radius_m",
        "SEGMENTS": 5,
        "OUTPUT": "memory:"
      },
      "engine": {
        "primary": {"name": "qgis_processing", "algorithm": "native:buffer"}
      },
      "log": "[GAP] 边界缓冲区: radius={radius}m",
      "comment": "边界外扩一个半径，用于空间粗筛扩大范围"
    },
    {
      "id": "spatial_filter",
      "input_source": "$source_layer",
      "input_boundary": "$boundary_buffer.output",
      "params": {
        "buffer_radius": "$radius_m",
        "max_features": 10000
      },
      "engine": {
        "primary": {"name": "qgis_spatial_index"}
      },
      "log": "[GAP] 空间筛选完成: candidates={candidates} selected={selected}",
      "comment": "用 QgsSpatialIndex 粗筛 + QgsGeometry.intersects 精筛"
    },
    {
      "id": "buffer",
      "input_source": "$spatial_filter.output",
      "params": {
        "DISTANCE": "$radius_m",
        "SEGMENTS": 5,
        "OUTPUT": "memory:"
      },
      "engine": {
        "primary": {"name": "qgis_processing", "algorithm": "native:buffer", "validate": "fc > 0"},
        "fallback": [
          {"name": "shapely", "method": "buffer", "validate": "fc > 0"}
        ]
      },
      "log": "[GAP] 缓冲区: radius={radius}m, fc={fc}",
      "comment": "对筛选后的点做缓冲区"
    },
    {
      "id": "dissolve",
      "input_source": "$buffer.output",
      "params": {
        "FIELD": [],
        "OUTPUT": "memory:"
      },
      "engine": {
        "primary": {"name": "qgis_processing", "algorithm": "native:dissolve", "validate": "fc > 0"},
        "fallback": [
          {"name": "shapely", "method": "union", "validate": "fc > 0 && area > 0"}
        ]
      },
      "log": "[GAP] 溶解完成: fc={fc}",
      "comment": "合并所有缓冲区圆为单个多边形"
    },
    {
      "id": "clip",
      "input_source": "$dissolve.output",
      "input_boundary": "$boundary_dissolve.output",
      "params": {
        "OUTPUT": "memory:"
      },
      "engine": {
        "primary": {"name": "qgis_processing", "algorithm": "native:clip", "validate": "fc > 0 && t > 0.1s"},
        "fallback": [
          {"name": "qgis_processing", "algorithm": "native:intersection", "validate": "fc > 0 && t > 0.1s"},
          {"name": "shapely_wkt", "method": "intersection", "validate": "not is_empty && area > 0"}
        ]
      },
      "log": "[GAP] 裁剪完成: fc={fc}, covered_area={covered_area:.0f} m²",
      "comment": "合并的缓冲区与边界求交集 = 覆盖区域。native:clip → native:intersection → Shapely WKT 三级 fallback"
    },
    {
      "id": "difference",
      "input_source": "$boundary_dissolve.output",
      "input_boundary": "$clip.output",
      "params": {},
      "engine": {
        "primary": {"name": "shapely_wkt", "method": "difference", "validate": "not is_empty"}
      },
      "log": "[GAP] 差值完成: gap_area={gap_area:.0f} m²",
      "comment": "盲区 = 边界 - 覆盖区域。纯 Shapely WKT 引擎，不走 QGIS native:difference"
    },
    {
      "id": "stats",
      "input_source": "$clip.output",
      "input_boundary": "$boundary_dissolve.output",
      "engine": {
        "primary": {"name": "shapely", "method": "area", "validate": "total_area > 0"}
      },
      "output_keys": ["source_count", "radius_m", "total_area", "covered_area", "gap_area", "coverage_rate", "gap_rate"],
      "log": "[GAP] 盲区分析: 覆盖率={coverage_rate:.1f}% 盲区率={gap_rate:.1f}% (gap={gap_area:.0f} / total={total_area:.0f} m²)",
      "comment": "面积统计强制走 Shapely。gap_area = total_area - covered_area"
    },
    {
      "id": "output_layer",
      "input_source": "$difference.output",
      "params": {
        "name_template": "{source_name}_gap_{radius_m}m",
        "add_to_project": true,
        "zoom_to_layer": true
      },
      "engine": {
        "primary": {"name": "qgis_memory_layer", "validate": "not is_empty"},
        "fallback": [
          {"name": "geojson_file", "path_template": "{output_dir}/{source_name}_gap_{radius_m}m.geojson", "validate": "not is_empty"}
        ]
      },
      "log": "[GAP] 输出图层: {layer_name} ({fc} 要素)",
      "comment": "输出盲区图层到画布。输出 basename 含 _gap_ 后缀区别于 coverage"
    }
  ]
}
